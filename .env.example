# Copy this file to `.env` in the same directory and fill in the values.
#
# This file is the EXAMPLE. It contains no real secrets and is safe to
# commit. `.env` holds your actual API key — add it to .gitignore and
# never share it. (If a key has ever been pasted into a chat, an issue, a
# screenshot, or an email: rotate it at console.anthropic.com.)
#
# Paths below are resolved relative to the directory containing the
# script, not the working directory, so cron works without a `cd`.

# ============================================================
# Required
# ============================================================

# The API key does NOT live here. It goes in its own file — by default
# api_key.txt beside the script — containing just the key on one line.
# Keeping it out of .env means this file can be read, copied, diffed or
# pasted somewhere without carrying the credential with it. The script
# refuses to start if it finds ANTHROPIC_API_KEY in .env.
#
#   echo "sk-ant-api03-YOURKEY" > api_key.txt
#   chmod 600 api_key.txt          # POSIX; on Windows use icacls
INDI_API_KEY_FILE=api_key.txt

# ============================================================
# Model and reply behaviour
# ============================================================

INDI_MODEL=claude-opus-5

# Ceiling on generated tokens per API call. Note this applies to EACH
# iteration of the tool loop, so with INDI_MAX_TOOL_LOOP_ITERATIONS=4 the
# worst case for one email is four times this. On Opus that adds up
# quickly — watch the first few days of billing.
INDI_MAX_TOKENS=16000

# false  -> replies are saved as Gmail drafts for review (recommended)
# true   -> replies are SENT immediately, unreviewed
#
# Before setting this to true, make sure INDI_ALLOWED_SENDERS is set, or
# accept that Indi will reply to newsletters and strangers. The loop
# guards (Auto-Submitted, Precedence, List-Id, no-reply senders, own
# address) are always on and are what keep an autoresponder on the other
# end from starting an unbounded reply loop.
INDI_SEND_AUTOMATICALLY=false

INDI_SYSTEM_PROMPT_PATH=system_prompt.txt
INDI_MAX_UNREAD_PER_RUN=10

# ============================================================
# Who Indi will talk to
# ============================================================

# Hard allowlist. Comma-separated addresses. Empty = anyone may write in.
# Strongly recommended while INDI_SEND_AUTOMATICALLY is true.
INDI_ALLOWED_SENDERS=

# --- Permission tiers ---------------------------------------------------
#
# Every list below accepts:
#     alice@example.com      one address
#     @example.com           any address at that domain
#     *                      everyone who writes in
#
# Senders who may use web fetch and code execution (Anthropic's sandbox).
# Everyone else gets web search only.
INDI_TRUSTED_SENDERS=*

# Senders whose history search ranges over ALL past correspondence rather
# than just their own thread. '*' makes the mailbox searchable by anyone
# who writes in — including other people's messages to Indi. That is your
# call to make; just make it knowingly.
INDI_HISTORY_ALL_SENDERS=*

# Require SPF/DKIM/DMARC to pass before honouring a tier above the
# baseline. A From header is free text; without this, granting anything by
# address grants it to anyone willing to type that address. Failing
# messages are downgraded to baseline, not rejected.
INDI_REQUIRE_AUTHENTICATED_SENDER=true

# Backstop against a loop the header checks somehow miss.
INDI_MAX_REPLIES_PER_SENDER_PER_DAY=10

# ============================================================
# Tools
# ============================================================

INDI_ENABLE_WEB_SEARCH=true
INDI_MAX_SEARCHES_PER_REPLY=3

# Web fetch is off by default and applies only to trusted senders even
# when on. Anthropic's guidance: enabling fetch where untrusted input
# meets sensitive data is a data-exfiltration risk. Narrow it further with
# a domain allowlist if you turn it on.
INDI_ENABLE_WEB_FETCH=false
INDI_MAX_FETCHES_PER_REPLY=3
INDI_WEB_FETCH_ALLOWED_DOMAINS=

# Code execution is off by default, and applies only to trusted senders.
# Note the cost shape: sessions bill at a five-minute minimum, and if any
# file is uploaded with the request the container time is billed even if
# no code runs. Leaving INDI_UPLOAD_TEXT_ATTACHMENTS=false inlines text
# attachments instead, which is cheaper for the common case.
INDI_ENABLE_CODE_EXECUTION=false
INDI_UPLOAD_TEXT_ATTACHMENTS=false

INDI_ENABLE_HISTORY_SEARCH=true
INDI_MAX_HISTORY_SEARCH_RESULTS=5
INDI_MAX_TOOL_LOOP_ITERATIONS=4

# ============================================================
# Attachments
# ============================================================

INDI_MAX_INCOMING_ATTACHMENT_MB=5
INDI_MAX_INLINE_ATTACHMENT_CHARS=40000
INDI_MAX_OUTGOING_ATTACHMENT_BYTES=1000000

# ============================================================
# Memory
# ============================================================

# Memory files are per correspondent ("Indi Memory - alice@example.com").
# Consolidation runs once this many of that person's messages have piled
# up un-folded.
INDI_MEMORY_BATCH_SIZE=5
INDI_MEMORY_MAX_TOKENS=4000

# Copy the old memory to "... (previous)" before each overwrite.
INDI_MEMORY_KEEP_BACKUP=true

# ============================================================
# Conversation context
# ============================================================
#
# A reply only contains the sender's new sentences; the earlier messages
# are fetched from the Gmail thread and shown alongside it. Without this,
# a message reading "yes, go ahead" arrives with nothing to go ahead with.

# Earlier messages from the same thread to include, newest kept first.
INDI_MAX_THREAD_MESSAGES=10

# Total character budget for that thread context. 0 turns it off.
INDI_MAX_THREAD_CHARS=12000

# Budget for the chain quoted below the sender's own text. Normally the
# same conversation the thread already supplies, so it is only included
# when it holds something the thread doesn't — a forward from elsewhere.
INDI_MAX_QUOTED_CHARS=6000

# ============================================================
# Storage / files
# ============================================================

# A Google Sheets cell caps at 50,000 characters; stay under it.
INDI_MAX_BODY_CHARS=45000

INDI_CREDENTIALS_PATH=credentials.json
INDI_TOKEN_PATH=token.json
INDI_LOCK_PATH=indi.lock
INDI_LOG_PATH=log.txt

# ============================================================
# Local machine access  —  READ THIS SECTION BEFORE ENABLING
# ============================================================
#
# Everything above runs somewhere else: web search and fetch run on
# Anthropic's servers, and the `code_execution` tool runs in Anthropic's
# container. Nothing can touch this machine.
#
# The settings below change that. With them on, an email arriving here
# becomes a path to reading files on this box and running code on it.
# That is remote code execution triggered by inbound mail. The system
# prompt does not stop it; only these settings and the OS do.
#
# Both features are off, and the allowlist is empty, by default.

# Addresses permitted to use local tools. SEPARATE from
# INDI_TRUSTED_SENDERS on purpose — trusting someone with web fetch is not
# the same as trusting them with a shell. A sender must be on BOTH lists.
# Empty = nobody, and the tools are never even described to the model.
#
# This is the ONE list that does not accept '*' or a whole domain. The
# script refuses to start if it finds a wildcard here, or in
# INDI_TRUSTED_SENDERS while local tools are on. Reading files on this
# machine and running code on this machine are the two capabilities where
# a wildcard means an unauthenticated stranger gets a shell on the box
# holding your OAuth tokens, your API key and your documents.
# Wildcards are REFUSED here — see the note at the top of this section.
# List addresses individually.
INDI_LOCAL_TOOLS_SENDERS=

# --- Local file access ---

INDI_ENABLE_LOCAL_FILES=false

# The one directory readable through the tools. No default — set it
# explicitly to a narrow directory. The script refuses to start if this
# contains the script's own directory (where .env, credentials.json and
# token.json live), if it is your home directory or /, or if it contains
# .ssh / .aws / .gnupg.
INDI_LOCAL_FILES_ROOT=

# Optional, and separate from the read root — leave empty for read-only.
# Keeping writes out of the readable tree stops a write from becoming a
# later read of content the model chose.
INDI_LOCAL_FILES_WRITABLE_ROOT=

# Readable/writable extensions. Empty = any extension (still subject to
# the built-in denylist: .env, tokens, *.pem, *.key, .ssh, .aws, ...).
INDI_LOCAL_FILE_EXTENSIONS=.txt,.md,.csv,.tsv,.json,.log,.yml,.yaml

INDI_MAX_LOCAL_FILE_BYTES=1000000
INDI_MAX_LOCAL_LISTING_ENTRIES=200

# --- Local code execution ---

INDI_ENABLE_LOCAL_EXEC=false

# docker      - container with no network, read-only rootfs, dropped
#               capabilities, memory/PID caps, a scratch mount, timeout.
#               This is a real boundary. Use it.
# subprocess  - runs as your user on your kernel with rlimits, a timeout,
#               a scratch cwd and a scrubbed environment. A seatbelt, not
#               a sandbox. Only for senders you'd hand a shell to.
INDI_LOCAL_EXEC_BACKEND=docker
INDI_LOCAL_EXEC_IMAGE=python:3.11-slim
INDI_LOCAL_EXEC_TIMEOUT=30
INDI_LOCAL_EXEC_MEMORY_MB=512

# Network inside the sandbox. Off means a script cannot phone home with
# whatever it read. Leave it off.
INDI_LOCAL_EXEC_ALLOW_NETWORK=false

INDI_MAX_LOCAL_CODE_CHARS=20000
INDI_MAX_LOCAL_OUTPUT_CHARS=8000
INDI_MAX_LOCAL_TOOL_CALLS_PER_REPLY=8

# ============================================================
# Initiative — Indi acting first
# ============================================================
#
# A heartbeat run (check_and_reply.py --heartbeat, on its own timer) where
# Indi decides whether to write to someone, make a journal entry, or do
# nothing. "Nothing" is the expected outcome most of the time.

INDI_ENABLE_OUTBOUND=true

# Hard ceilings on self-initiated mail. The heartbeat timer sets how often
# Indi gets the chance to consider acting; these set how much it can
# actually do.
INDI_OUTBOUND_MAX_PER_DAY=5
INDI_OUTBOUND_MAX_PER_RECIPIENT_PER_DAY=1

# false = Indi may only write to people it is already corresponding with.
# true lets it write to any address it can name, including one it got
# wrong or read off a web page. Leave it false unless you have a reason.
INDI_OUTBOUND_ALLOW_NEW_RECIPIENTS=false

# Journal entries: Indi's notes to itself, stored in the Journal tab and
# read back on later heartbeats. This is "messaging itself" without
# routing through the mailbox, where a self-reply loop would have no
# natural stopping point.
INDI_JOURNAL_MAX_PER_DAY=24
INDI_HEARTBEAT_JOURNAL_ENTRIES=10

# ============================================================
# Self-modification
# ============================================================
#
# Indi can read its own source. With a sender named below, it can also
# change it: the change goes on a git branch, the test suite runs, and it
# merges only if the tests pass. Effective on the next run.
#
# Protected from automatic change: config.py, local_tools.py, gmail_io.py,
# self_code.py, tests/ and deploy/, plus any INDI-PROTECTED-BEGIN region.
# Those are the permission and containment code, and the gate itself.

INDI_ENABLE_SELF_CODE=true

# Wildcards are REFUSED here. Anyone who can change the harness can, over
# a few steps, reach the code that decides what anyone is allowed to do.
INDI_SELF_CODE_SENDERS=

# false = passing changes wait on a branch for you to merge.
INDI_SELF_CODE_AUTO_APPLY=true
INDI_SELF_CODE_TEST_COMMAND=python3 -m pytest tests -q
INDI_SELF_CODE_TEST_TIMEOUT=300
INDI_MAX_SELF_CODE_CHANGES_PER_RUN=2

# Refuse a rewrite smaller than this fraction of the current file. Catches
# truncated content, which can still parse and still import.
INDI_SELF_CODE_MIN_SIZE_RATIO=0.6

# ============================================================
# Running one .env on more than one machine
# ============================================================
#
# Any setting above can take a platform suffix, and the suffixed value
# wins where it applies. The generic name remains the fallback, so
# anything that's the same everywhere is still written once.
#
#     _WINDOWS   _LINUX   _MACOS
#
# Paths expand `~`, so a single home-relative value works on both:
#
#     INDI_LOCAL_FILES_ROOT=~/indi-workspace
#     INDI_LOCAL_FILES_WRITABLE_ROOT=~/indi-workspace-out
#
# resolving to C:\Users\<you>\indi-workspace on Windows and
# /home/indi/indi-workspace on the server.
#
# The settings that genuinely have to differ:
#
#     # Windows has no usable execution backend — the subprocess one has
#     # no resource limits there and is refused, and Docker is not in use.
#     INDI_ENABLE_LOCAL_EXEC=false
#     INDI_ENABLE_LOCAL_EXEC_LINUX=true
#     INDI_LOCAL_EXEC_BACKEND_LINUX=docker
#
#     # The Windows box is shared with your own files; the VPS isn't.
#     INDI_LOCAL_FILES_SENDERS is not a thing — use INDI_LOCAL_TOOLS_SENDERS,
#     and consider leaving local files off on Windows entirely:
#     INDI_ENABLE_LOCAL_FILES=false
#     INDI_ENABLE_LOCAL_FILES_LINUX=true
#
# Note that .env is in the rsync/scp exclude list on purpose, so syncing
# the harness won't overwrite the server's copy with your local one. If
# you'd rather keep them genuinely separate, that's simpler than this —
# two files, one per machine, no suffixes needed.

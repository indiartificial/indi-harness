.env
# Backups Indi keeps when it changes .env, and the temporary file.
.env.*
!.env.example
token.json
credentials.json
indi.lock
log.txt
__pycache__/
*.pyc

api_key.txt

# Who has accepted the terms. Personal data, and machine-local.
data/correspondents.db

# Correspondents' files, both directions. Personal data, and machine-local.
data/attachments/

# Cached Gmail headers (From/To/Cc/date per message id). Rebuildable, and
# it holds correspondents' addresses, so it stays on the machine.
data/gmail_meta_cache.json
data/gmail_meta_cache.json.tmp

# Pre-send check retry counts (check_and_reply._check_unavailable).
data/check_attempts.json

# Alert rate-limiting state (alerts.py).
data/alert_state.json
data/alert_state.tmp

# The staging copy's virtual clock (clock.py).
data/virtual_clock.json

# Operator decisions on newcomers (approvals.py).
data/approvals.json
data/approvals.tmp

# Which commit last failed to push, so the alert fires once (git_sync.py).
data/git_sync.json

# Standing notes and proposals (standing_notes.py).
data/standing_notes.json
data/standing_notes.tmp

# Memory deletions waiting to be retried (memory_rights.py).
data/memory_purges.json
data/memory_purges.tmp

# Linked addresses and pending link codes (address_links.py).
data/address_links.json
data/address_links.tmp

# Indi's recorded claims and how they turned out (calibration.py).
data/calibration.json
data/calibration.tmp
